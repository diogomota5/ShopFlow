# ----- Banco de Dados ----- #
DB_URL=jdbc:postgresql://localhost:5432/shopflow
DB_USERNAME=
DB_PASSWORD=

# ----- Hibernate ----- #
HIBERNATE_DDL_AUTO=validate
SHOW_SQL=false

# ----- JWT (gere um segredo forte: openssl rand -hex 64) ----- #
JWT_SECRET=

# ----- Cloudinary ----- #
CLOUDINARY_NAME=
CLOUDINARY_KEY=
CLOUDINARY_SECRET=

# ----- E-mail ----- #
FRONTEND_URL=http://localhost:4200
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true


# ----- pgAdmin ----- #
PGADMIN_EMAIL=
PGADMIN_PASSWORD=

# ----- CORS (separe múltiplas origens com vírgula, sem espaços) ----- #
# Exemplo produção: ALLOWED_ORIGINS=https://seudominio.com
ALLOWED_ORIGINS=http://localhost:4200